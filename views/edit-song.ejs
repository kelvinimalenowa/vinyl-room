<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Song | Vinyl Room</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/songs.css">
</head>

<body class="home-page">

    <header class="site-header">
        <nav class="navbar">
            <a href="/" class="logo">VINYL ROOM</a>

            <div class="nav-links">
                <a href="/">Discover</a>
                <a href="/profile">My Profile</a>
            </div>
        </nav>
    </header>

    <main class="song-form-page">

        <div class="song-form-heading">
            <p class="eyebrow">YOUR COLLECTION</p>
            <h1>Fine-tune your pick.</h1>
            <p>Make changes to the track you've shared with the room.</p>
        </div>

        <div class="song-form-layout">

            <section class="song-form-card">

                <form action="/songs/<%= song._id %>?_method=PUT" method="POST">

                    <div class="form-group">
                        <label for="title">Song Title <span>*</span></label>
                        <input type="text" id="title" name="title" value="<%= song.title %>" maxlength="150" required>
                    </div>

                    <div class="form-group">
                        <label for="artist">Artist <span>*</span></label>
                        <input type="text" id="artist" name="artist" value="<%= song.artist %>" maxlength="150"
                            required>
                    </div>

                    <div class="form-row">

                        <div class="form-group">
                            <label for="album">Album</label>
                            <input type="text" id="album" name="album" value="<%= song.album || '' %>" maxlength="150">
                        </div>

                        <div class="form-group">
                            <label for="genre">Genre <span>*</span></label>
                            <input type="text" id="genre" name="genre" value="<%= song.genre %>" maxlength="100"
                                required>
                        </div>

                    </div>

                    <div class="form-group">
                        <label for="description">Why this song?</label>
                        <textarea id="description" name="description" rows="5"
                            maxlength="2000"><%= song.description || '' %></textarea>

                        <p class="field-hint">
                            Tell the room what makes this track special.
                        </p>
                    </div>

                    <div class="form-actions">
                        <a href="/songs/<%= song._id %>" class="cancel-link">
                            Cancel
                        </a>

                        <button type="submit" class="submit-song">
                            Save Changes →
                        </button>
                    </div>

                </form>

            </section>

            <aside class="song-form-aside">

                <div class="preview-record" aria-hidden="true">
                    <div class="preview-record-label"></div>
                </div>

                <h2>Make it yours.</h2>

                <p>
                    Change the details, update your thoughts,
                    or give this track a little more context.
                </p>

                <div class="aside-divider"></div>

                <p class="aside-note">
                    <span>✦</span>
                    Your updates will appear on your profile
                    and in the community discovery feed.
                </p>

            </aside>

        </div>

    </main>

    <footer class="site-footer">
        <p>&copy; 2026 Vinyl Room. Made for music lovers.</p>
    </footer>

</body>

</html>